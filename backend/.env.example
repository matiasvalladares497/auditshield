# ============================================================
# AuditShield Backend — Variables de Entorno
# Copia este archivo a .env y completa los valores
# ============================================================

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://auditshield:auditshield_secret@localhost:5432/auditshield

# Redis
REDIS_URL=redis://localhost:6379/0

# Seguridad JWT
SECRET_KEY=cambia-esta-clave-en-produccion-usa-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno
ENVIRONMENT=development
DEBUG=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reportes
REPORTS_DIR=/reports/assets

# APIs externas (opcional)
# SHODAN_API_KEY=tu_clave_aqui
# NVD_API_KEY=tu_clave_aqui  # Mejora rate limits de la API de NIST

# Email (opcional para notificaciones)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASSWORD=tu_password
